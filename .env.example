# ─── Backend (.env placed in backend/ directory) ───

# Anthropic API key for Claude Vision + Medical Review
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Database connection string (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./claims.db

# Environment (development | production)
ENVIRONMENT=development


# ─── Frontend (.env.local placed in frontend/ directory) ───

# Backend API URL (uncomment and set if backend runs on different port/host)
# NEXT_PUBLIC_API_URL=http://localhost:8000
